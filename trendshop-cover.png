<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#090909">
<title>TREND SHOP — одежда, обувь и аксессуары</title>
<style>
:root{--bg:#090909;--panel:#141414;--line:#292929;--red:#ef233c;--muted:#aaa;--white:#f5f5f5}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--white);font-family:Arial,Helvetica,sans-serif}
a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}
.wrap{width:min(1160px,92%);margin:auto}
header{position:sticky;top:0;z-index:10;background:#090909eF;border-bottom:1px solid var(--line);backdrop-filter:blur(12px)}
.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.logo{font-weight:1000;letter-spacing:1px;font-size:23px}.logo b{color:var(--red)}
nav{display:flex;gap:22px;color:#ccc;font-size:14px}nav a:hover{color:var(--red)}
.pill,.btn{border:0;background:var(--red);color:white;padding:13px 19px;border-radius:8px;font-weight:800;display:inline-block}
.hero{padding:60px 0 46px;background:radial-gradient(ellipse at 80% 40%,#4c1018 0%,#16090b 28%,#090909 67%);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:32px}
.eyebrow{color:var(--red);font-size:12px;letter-spacing:4px;font-weight:900}
h1{font-size:clamp(42px,7vw,78px);line-height:.95;margin:16px 0;font-weight:1000;letter-spacing:-3px}
h1 span{color:var(--red)}.lead{color:#c5c5c5;line-height:1.7;max-width:500px}
.hero-art{border:1px solid #3a2427;border-radius:18px;overflow:hidden;box-shadow:0 20px 70px #000}
.hero-art img{display:block;width:100%;height:360px;object-fit:cover;object-position:center}
.hero-placeholder{height:360px;display:grid;place-items:center;background:linear-gradient(145deg,#1b1b1b,#320d13);font-size:70px}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.btn.secondary{background:#222;border:1px solid #444}
section{padding:48px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}
h2{font-size:30px;margin:0}.sub{color:var(--muted);font-size:14px;margin-top:8px}
.categories{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.cat{background:linear-gradient(135deg,#191919,#101010);border:1px solid var(--line);padding:23px;border-radius:12px;min-height:105px;transition:.2s}
.cat:hover,.product:hover{border-color:var(--red);transform:translateY(-2px)}.cat strong{display:block;font-size:18px;margin-top:10px}.cat span{font-size:25px}
.toolbar{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
.filters{display:flex;gap:8px;flex-wrap:wrap}.filter{background:#171717;color:#ddd;border:1px solid #333;padding:9px 14px;border-radius:30px}.filter.active{background:var(--red);border-color:var(--red);color:white}
input,select{background:#151515;color:white;border:1px solid #333;border-radius:8px;padding:11px}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.product{border:1px solid var(--line);border-radius:12px;background:var(--panel);overflow:hidden;transition:.2s}
.product-photo{height:190px;display:grid;place-items:center;background:linear-gradient(145deg,#242424,#111);font-size:56px}
.product-info{padding:14px}.tag{font-size:10px;color:var(--red);font-weight:900;letter-spacing:1.5px}.product h3{font-size:16px;margin:8px 0}.desc{color:#999;font-size:12px;min-height:30px}.price-row{display:flex;justify-content:space-between;align-items:center;margin-top:13px}.price{font-weight:900}.add{background:#292929;border:1px solid #444;color:white;border-radius:7px;padding:8px 11px}.add:hover{background:var(--red);border-color:var(--red)}
.note{color:#888;font-size:12px;margin-top:15px}
.banner{background:linear-gradient(100deg,#310c12,#151515);border:1px solid #52202a;border-radius:14px;padding:28px;display:flex;justify-content:space-between;align-items:center;gap:20px}
.banner p{color:#ccc;margin-bottom:0}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.info{padding:20px;background:#141414;border:1px solid var(--line);border-radius:12px}.info strong{display:block;margin:10px 0}.info p{color:#aaa;font-size:13px;line-height:1.6;margin:0}
footer{border-top:1px solid var(--line);padding:28px 0;color:#888;font-size:13px}.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.cart-fab{position:fixed;right:20px;bottom:20px;background:var(--red);color:white;border:0;border-radius:50px;padding:15px 20px;font-weight:900;box-shadow:0 8px 30px #000}
@media(max-width:800px){nav{display:none}.hero-grid{grid-template-columns:1fr}.hero-art img,.hero-placeholder{height:250px}.products{grid-template-columns:repeat(2,1fr)}.categories,.info-grid{grid-template-columns:1fr}.banner{align-items:flex-start;flex-direction:column}}
@media(max-width:420px){.products{grid-template-columns:1fr 1fr}.product-photo{height:145px}.product-info{padding:10px}.product h3{font-size:14px}.nav{height:62px}.logo{font-size:19px}}
</style>
</head>
<body>
<header><div class="wrap nav">
<a class="logo" href="#">TREND <b>SHOP</b> 👑</a>
<nav><a href="#catalog">Каталог</a><a href="#delivery">Доставка</a><a href="#about">О магазине</a></nav>
<a class="pill" href="https://t.me/trend.shop_" target="_blank" rel="noopener">Написать нам</a>
</div></header>
<main>
<div class="hero"><div class="wrap hero-grid">
<div><div class="eyebrow">CLOTHING • SHOES • ACCESSORIES</div>
<h1>ТВОЙ СТИЛЬ.<br><span>ТВОИ ПРАВИЛА.</span></h1>
<p class="lead">Одежда, обувь и аксессуары для твоего образа. Выбирай понравившиеся вещи и отправляй заявку прямо в Telegram.</p>
<div class="actions"><a class="btn" href="#catalog">Смотреть каталог</a><a class="btn secondary" href="https://t.me/trend.shop_" target="_blank" rel="noopener">Telegram-магазин ↗</a></div></div>
<div class="hero-art"><img src="trendshop-cover.png" alt="TREND SHOP — фирменное оформление"></div>
</div></div>
<section class="wrap" id="categories"><div class="section-head"><div><h2>Выбирай категорию</h2><div class="sub">Найди то, что подходит именно тебе.</div></div></div>
<div class="categories">
<a class="cat" href="#catalog" data-jump="Одежда"><span>👕</span><strong>Одежда</strong></a>
<a class="cat" href="#catalog" data-jump="Обувь"><span>👟</span><strong>Обувь</strong></a>
<a class="cat" href="#catalog" data-jump="Аксессуары"><span>💎</span><strong>Аксессуары</strong></a>
</div></section>
<section class="wrap" id="catalog"><div class="section-head"><div><h2>Каталог товаров</h2><div class="sub">Выбери товар и отправь заявку.</div></div></div>
<div class="toolbar"><div class="filters"><button class="filter active" data-filter="Все">Все</button><button class="filter" data-filter="Одежда">Одежда</button><button class="filter" data-filter="Обувь">Обувь</button><button class="filter" data-filter="Аксессуары">Аксессуары</button></div><input id="search" placeholder="Поиск товара…"></div>
<div class="products" id="products"></div>
<p class="note">* Товары, цены и характеристики ниже — демонстрационные примеры. Замени их на свои реальные предложения перед публикацией.</p>
</section>
<section class="wrap" id="delivery"><div class="banner"><div><h2>Доставка по Молдове 🇲🇩</h2><p>Уточни стоимость, сроки и доступные способы доставки у администратора.</p></div><a class="btn" href="https://t.me/trend.shop_" target="_blank" rel="noopener">Уточнить доставку</a></div></section>
<section class="wrap" id="about"><div class="section-head"><div><h2>Почему TREND SHOP?</h2><div class="sub">Покупка должна быть простой и понятной.</div></div></div>
<div class="info-grid"><div class="info"><span>🛍️</span><strong>Выбор товаров</strong><p>Одежда, обувь и аксессуары в одном каталоге.</p></div><div class="info"><span>💬</span><strong>Связь напрямую</strong><p>Задай вопрос и уточни наличие перед заказом.</p></div><div class="info"><span>📦</span><strong>Доставка</strong><p>Условия и детали доставки согласовываются при оформлении.</p></div></div></section>
</main>
<footer><div class="wrap foot"><span>© TREND SHOP · Магазин одежды</span><span>Молдова 🇲🇩 · <a href="https://t.me/trend.shop_" target="_blank" rel="noopener">@trend.shop_</a></span></div></footer>
<button class="cart-fab" id="cart">🛒 Заявка: <span id="count">0</span></button>
<script>
const items=[
 {name:"Худи базовое",cat:"Одежда",price:0,emoji:"🧥",desc:"Размеры и цвета уточняются"},
 {name:"Спортивный костюм",cat:"Одежда",price:0,emoji:"🥋",desc:"Уточни доступные модели"},
 {name:"Кроссовки",cat:"Обувь",price:0,emoji:"👟",desc:"Размеры уточняются"},
 {name:"Сумка через плечо",cat:"Аксессуары",price:0,emoji:"🎒",desc:"Уточни наличие"}
];
let filter="Все",cart=[];
const root=document.getElementById("products");
function render(){
 const q=document.getElementById("search").value.toLowerCase();
 root.innerHTML="";
 items.filter(x=>(filter==="Все"||x.cat===filter)&&x.name.toLowerCase().includes(q)).forEach((x,i)=>{
 const realIndex=items.indexOf(x),el=document.createElement("article");el.className="product";
 el.innerHTML=`<div class="product-photo">${x.emoji}</div><div class="product-info"><div class="tag">${x.cat.toUpperCase()}</div><h3>${x.name}</h3><div class="desc">${x.desc}</div><div class="price-row"><span class="price">Цена уточняется</span><button class="add" data-add="${realIndex}">Выбрать +</button></div></div>`;root.appendChild(el);
 });
 document.querySelectorAll("[data-add]").forEach(b=>b.onclick=()=>{cart.push(items[+b.dataset.add]);document.getElementById("count").textContent=cart.length;b.textContent="Добавлено ✓";});
}
document.querySelectorAll(".filter").forEach(b=>b.onclick=()=>{document.querySelectorAll(".filter").forEach(x=>x.classList.remove("active"));b.classList.add("active");filter=b.dataset.filter;render();});
document.getElementById("search").addEventListener("input",render);
document.querySelectorAll("[data-jump]").forEach(a=>a.addEventListener("click",()=>{filter=a.dataset.jump;document.querySelectorAll(".filter").forEach(x=>{x.classList.toggle("active",x.dataset.filter===filter)});render()}));
document.getElementById("cart").onclick=()=>{
 if(!cart.length){alert("Сначала выбери товар в каталоге.");return;}
 const lines=cart.map((x,i)=>`${i+1}. ${x.name} — ${x.cat}`).join("\\n");
 const msg=encodeURIComponent("Здравствуйте! Хочу оформить заявку в TREND SHOP:\\n"+lines+"\\nПодскажите, пожалуйста, цену и наличие.");
 window.open("https://t.me/trend.shop_?text="+msg,"_blank");
};
render();
</script>
</body></html>